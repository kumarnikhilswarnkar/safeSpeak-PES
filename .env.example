# SafeSpeak PES: configuration for the Docker Compose stack.
# Create .env with random secrets:   python scripts/generate_env.py
# .env is git-ignored. NEVER commit real passwords or secrets.
# (backend/.env.example is for running the backend natively without Docker.)

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Owns the schema; used only by the migrate and seed jobs.
OWNER_DB_USER=safespeak_owner
OWNER_DB_PASSWORD=
# Least-privilege account used by the running API (no DELETE, no schema changes).
APP_DB_USER=safespeak_app
APP_DB_PASSWORD=
APP_DB_NAME=safespeak

# --- Backend ------------------------------------------------------------------
JWT_SECRET_KEY=
# Local Docker / Codespaces demo: development + demo accounts on the reserved test domain.
# Production: ENVIRONMENT=production, DEMO_MODE=false, SEED_DEMO_USERS=false and the
# institutional email domain (demo mode and test domains are refused in production).
ENVIRONMENT=development
ALLOWED_EMAIL_DOMAINS=safespeak.test
DEMO_MODE=true
TAT_MONITOR_INTERVAL_SECONDS=30
DISPLAY_TIMEZONE=Asia/Kolkata
# Versioned model artifact baked into the backend image (ml/artifacts/<MODEL_VERSION>).
MODEL_VERSION=v3

# --- Seeding (docker compose run --rm seed) -----------------------------------
SEED_DEMO_USERS=true
# Password for every demo account (development/demo only).
DEMO_PASSWORD=

# --- Proxy --------------------------------------------------------------------
HTTP_PORT=8080
