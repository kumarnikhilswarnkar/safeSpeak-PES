# Copy this file to .env and fill in real values. Never commit .env.

# development | test | production
ENVIRONMENT=development

# SQLite for local development. PostgreSQL later, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/safespeak
DATABASE_URL=sqlite:///./safespeak_dev.db
# PostgreSQL instead (e.g. the Docker dev database on 127.0.0.1:5433):
# DATABASE_URL=postgresql+psycopg://safespeak_app:<password>@127.0.0.1:5433/safespeak
# Optional separate schema-owner account used only by Alembic migrations:
# MIGRATION_DATABASE_URL=postgresql+psycopg://safespeak_owner:<password>@127.0.0.1:5433/safespeak
# Tests against PostgreSQL (disposable database; schema is dropped and recreated per test):
# TEST_DATABASE_URL=postgresql+psycopg://safespeak_owner:<password>@127.0.0.1:5433/safespeak_test

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt work factor (4-15). Keep 12 or higher outside tests.
BCRYPT_ROUNDS=12

# Comma-separated institutional email domains allowed to sign in, without "@".
# Exact match only: "example.edu" does not allow "dept.example.edu".
# If empty, ALL sign-in is refused (HTTP 503) and demo seeding is refused.
# For local demos a reserved, clearly fake domain works, e.g. safespeak.test
# (reserved test domains are accepted only when ENVIRONMENT is not production).
ALLOWED_EMAIL_DOMAINS=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Timezone used for display and for the year in complaint IDs (SSP-YYYY-NNNNNN).
DISPLAY_TIMEZONE=Asia/Kolkata

# AI triage model produced by ml/train_triage_v2.py (default: ../ml/artifacts/v2).
# MODEL_DIR=
# Complaints with category or priority confidence below this go to human review.
# Leave unset to use the threshold selected on cross-validation data (model metadata.json).
# CONFIDENCE_THRESHOLD=
# High and Critical AI priorities always require human review.
REVIEW_HIGH_SEVERITY=true

# Automatic TAT monitor: background check for overdue complaints, which are escalated
# to the next level automatically. Run the API with a single worker process.
TAT_MONITOR_ENABLED=true
TAT_MONITOR_INTERVAL_SECONDS=60

# Demo-only endpoints (TAT breach simulation). Must be false in production.
DEMO_MODE=false
