# Copy this file to .env and fill in real values. Never commit .env.

# development | test | production
ENVIRONMENT=development

# SQLite for local development. PostgreSQL later, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/safespeak
DATABASE_URL=sqlite:///./safespeak_dev.db

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated institutional email domains allowed to sign in, without "@".
# Intentionally empty: set the domain(s) confirmed for the demo.
ALLOWED_EMAIL_DOMAINS=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Timezone used for display and for the year in complaint IDs (SSP-YYYY-NNNNNN).
DISPLAY_TIMEZONE=Asia/Kolkata
